@@ -59,6 +143,12 @@ void render_texture(void *pixels,  void *previous)
                 mode = GB_is_odd_frame(&gb)? GB_FRAME_BLENDING_MODE_ACCURATE_ODD : GB_FRAME_BLENDING_MODE_ACCURATE_EVEN;
             }
         }
+        if (capture_stream) {
