+/* ---- Internal key script and frame-limited run ------------------------
+ * Same format as 00_Tools/sameboy_capture.c:
+ *   --keys "232:p:start,242:r:start"
+ * Events are applied before the frame with that index runs, so no external
+ * input injection (xdotool etc.) is involved. */
+extern bool capture_pending;
+extern FILE *capture_stream;
+
+typedef struct {
+    unsigned frame;
+    bool press;
+    GB_key_t keys[4];
+    unsigned count;
+} input_event_t;
+
+static input_event_t input_events[512];
+static unsigned input_event_count = 0;
+static unsigned frame_limit = 0;      /* 0 = unlimited */
+static unsigned record_from_frame = 0;
+static unsigned frame_index = 0;
+static bool capture_active = false;
+
+static GB_key_t key_from_name(const char *name)
+{
+    static const struct { const char *name; GB_key_t key; } table[] = {
+        {"right", GB_KEY_RIGHT}, {"left", GB_KEY_LEFT}, {"up", GB_KEY_UP},
+        {"down", GB_KEY_DOWN}, {"a", GB_KEY_A}, {"b", GB_KEY_B},
+        {"select", GB_KEY_SELECT}, {"start", GB_KEY_START},
+    };
+    for (size_t i = 0; i < sizeof(table) / sizeof(table[0]); i++)
+        if (strcmp(table[i].name, name) == 0) return table[i].key;
+    return GB_KEY_MAX;
+}
+
+static bool get_arg_value(const char *flag, int *argc, char **argv,
+                          const char **value)
+{
+    for (int i = 1; i < *argc - 1; i++) {
+        if (strcmp(argv[i], flag) == 0) {
+            if (value) *value = argv[i + 1];
+            for (int j = i; j + 2 < *argc; j++) argv[j] = argv[j + 2];
+            *argc -= 2;
+            return true;
+        }
+    }
+    return false;
+}
+
+static void parse_input_script(const char *script)
+{
+    char *copy = strdup(script);
+    for (char *entry = strtok(copy, ","); entry && input_event_count < 512;
+         entry = strtok(NULL, ",")) {
+        char *first = strchr(entry, ':');
+        if (!first) continue;
+        *first = 0;
+        char *second = strchr(first + 1, ':');
+        if (!second) continue;
+        *second = 0;
+        input_event_t *event = &input_events[input_event_count];
+        event->frame = (unsigned) strtoul(entry, NULL, 0);
+        event->press = strcmp(first + 1, "p") == 0;
+        event->count = 0;
+        char *key_text = strtok(second + 1, "+");
+        while (key_text && event->count < 4) {
+            GB_key_t key = key_from_name(key_text);
+            if (key != GB_KEY_MAX) event->keys[event->count++] = key;
+            key_text = strtok(NULL, "+");
+        }
+        if (event->count) input_event_count++;
+    }
+    free(copy);
+}
+
+static void apply_input_events(unsigned frame)
+{
+    for (unsigned i = 0; i < input_event_count; i++) {
+        if (input_events[i].frame != frame) continue;
+        for (unsigned k = 0; k < input_events[i].count; k++)
+            GB_set_key_state(&gb, input_events[i].keys[k], input_events[i].press);
+    }
+}
+
 static void run(void)
 {
     SDL_ShowCursor(SDL_DISABLE);
@@ -592,7 +675,31 @@ restart:
                 }
                 do_rewind = false;
             }
-            GB_run(&gb);
+            if (capture_active) {
+                apply_input_events(frame_index);
+                capture_pending = frame_index >= record_from_frame;
+            }
+            /* In capture mode run a whole frame unconditionally: GB_run() stops at
+             * the next vblank, which never comes while the boot ROM has the LCD
+             * off, so the run would crawl. */
+            if (capture_active) {
+                GB_run_frame(&gb);
+            }
+            else {
+                GB_run(&gb);
+            }
+            if (capture_active) {
+                frame_index++;
+                if (frame_limit && frame_index >= frame_limit) {
+                    if (capture_stream) {
+                        fflush(capture_stream);
+                        fclose(capture_stream);
+                        capture_stream = NULL;
+                    }
+                    fprintf(stderr, "captured %u frames\n", frame_index);
+                    exit(0);
+                }
+            }
         }
         
         /* These commands can't run in the handle_event function, because they're not safe in a vblank context. */
