+/* ---- Internal key script, frame limit and recording ------------------- */
+extern bool capture_pending;
+extern FILE *capture_stream;
+
+typedef struct {
+    unsigned frame;
+    bool press;
+    GB_key_t keys[4];
+    unsigned count;
+} input_event_t;
+
+static input_event_t input_events[512];
+static unsigned input_event_count = 0;
+static unsigned frame_limit = 0;
+static unsigned record_from_frame = 0;
+static unsigned frame_index = 0;
+static bool capture_active = false;
+static bool boot_complete = false;
+
+#define AUDIO_SAMPLE_RATE 48000
+static FILE *audio_file = NULL;
+static unsigned long long audio_sample_count = 0;
+static bool audio_active = false;
+
+static GB_key_t key_from_name(const char *name)
+{
+    static const struct { const char *name; GB_key_t key; } table[] = {
+        {"right", GB_KEY_RIGHT}, {"left", GB_KEY_LEFT}, {"up", GB_KEY_UP},
+        {"down", GB_KEY_DOWN}, {"a", GB_KEY_A}, {"b", GB_KEY_B},
+        {"select", GB_KEY_SELECT}, {"start", GB_KEY_START},
+    };
+    for (size_t i = 0; i < sizeof(table) / sizeof(table[0]); i++)
+        if (strcmp(table[i].name, name) == 0) return table[i].key;
+    return GB_KEY_MAX;
+}
+
+static void parse_input_script(const char *script)
+{
+    char *copy = strdup(script);
+    /* strtok_r, not strtok: the key list is split inside the event loop and
+     * plain strtok() would share its state and corrupt the outer split. */
+    char *outer_save = NULL;
+    for (char *entry = strtok_r(copy, ",", &outer_save);
+         entry && input_event_count < 512;
+         entry = strtok_r(NULL, ",", &outer_save)) {
+        char *first = strchr(entry, ':');
+        if (!first) continue;
+        *first = 0;
+        char *second = strchr(first + 1, ':');
+        if (!second) continue;
+        *second = 0;
+        input_event_t *event = &input_events[input_event_count];
+        event->frame = (unsigned) strtoul(entry, NULL, 0);
+        event->press = strcmp(first + 1, "p") == 0;
+        event->count = 0;
+        char *inner_save = NULL;
+        char *key_text = strtok_r(second + 1, "+", &inner_save);
+        while (key_text && event->count < 4) {
+            GB_key_t key = key_from_name(key_text);
+            if (key != GB_KEY_MAX) event->keys[event->count++] = key;
+            key_text = strtok_r(NULL, "+", &inner_save);
+        }
+        if (event->count) input_event_count++;
+    }
+    free(copy);
+}
+
+static void apply_input_events(unsigned frame)
+{
+    for (unsigned i = 0; i < input_event_count; i++) {
+        if (input_events[i].frame != frame) continue;
+        for (unsigned k = 0; k < input_events[i].count; k++)
+            GB_set_key_state(&gb, input_events[i].keys[k], input_events[i].press);
+    }
+}
+
+static void audio_file_callback(GB_gameboy_t *gb, GB_sample_t *sample)
+{
+    (void) gb;
+    if (!audio_active) return;
+    int16_t frame[2] = {sample->left, sample->right};
+    fwrite(frame, sizeof(frame), 1, audio_file);
+    audio_sample_count++;
+}
+
+static void audio_file_close(void)
+{
+    if (!audio_file) return;
+    unsigned data_size = (unsigned) (audio_sample_count * 4);
+    unsigned riff_size = 36 + data_size;
+    unsigned char header[44] = {
+        'R','I','F','F',
+        riff_size & 0xFF, (riff_size >> 8) & 0xFF, (riff_size >> 16) & 0xFF, (riff_size >> 24) & 0xFF,
+        'W','A','V','E','f','m','t',' ',
+        16, 0, 0, 0,
+        1, 0, 2, 0,
+        AUDIO_SAMPLE_RATE & 0xFF, (AUDIO_SAMPLE_RATE >> 8) & 0xFF, (AUDIO_SAMPLE_RATE >> 16) & 0xFF, (AUDIO_SAMPLE_RATE >> 24) & 0xFF,
+        (AUDIO_SAMPLE_RATE * 4) & 0xFF, ((AUDIO_SAMPLE_RATE * 4) >> 8) & 0xFF, ((AUDIO_SAMPLE_RATE * 4) >> 16) & 0xFF, ((AUDIO_SAMPLE_RATE * 4) >> 24) & 0xFF,
+        4, 0,
+        16, 0,
+        'd','a','t','a',
+        data_size & 0xFF, (data_size >> 8) & 0xFF, (data_size >> 16) & 0xFF, (data_size >> 24) & 0xFF,
+    };
+    fseek(audio_file, 0, SEEK_SET);
+    fwrite(header, 1, sizeof(header), audio_file);
+    fclose(audio_file);
+    audio_file = NULL;
+    fprintf(stderr, "audio: %llu samples\n", audio_sample_count);
+}
