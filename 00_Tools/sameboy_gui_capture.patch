+/* ---- Internal frame capture -------------------------------------------
+ * Renders the MonoLCD shader into an offscreen framebuffer and reads it back,
+ * so a headless X server never has to present anything. Main.c sets
+ * capture_pending before each frame it wants written. */
+static void capture_rendered_frame(void);
+bool capture_pending = false;
+FILE *capture_stream = NULL;
+static GLuint capture_fbo = 0, capture_texture = 0;
+static int capture_fbo_width = 0, capture_fbo_height = 0;
+static uint8_t *capture_rgba = NULL;
+static size_t capture_rgba_size = 0;
+static uint8_t *capture_row = NULL;
+static size_t capture_row_size = 0;
+
+static void capture_rendered_frame(void)
+{
+    if (!capture_pending || !capture_stream) return;
+    capture_pending = false;
+    int cap_w = capture_fbo_width, cap_h = capture_fbo_height;
+    size_t rgba_size = (size_t) cap_w * cap_h * 4;
+    size_t row_size = (size_t) cap_w * 3;
+    if (rgba_size > capture_rgba_size) {
+        free(capture_rgba);
+        capture_rgba = malloc(rgba_size);
+        capture_rgba_size = capture_rgba ? rgba_size : 0;
+        if (!capture_rgba) return;
+    }
+    if (row_size > capture_row_size) {
+        free(capture_row);
+        capture_row = malloc(row_size);
+        capture_row_size = capture_row ? row_size : 0;
+        if (!capture_row) return;
+    }
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glReadPixels(0, 0, cap_w, cap_h, GL_RGBA, GL_UNSIGNED_BYTE, capture_rgba);
+    for (int y = cap_h - 1; y >= 0; y--) {
+        const uint8_t *src = capture_rgba + (size_t) y * cap_w * 4;
+        for (int x = 0; x < cap_w; x++) {
+            capture_row[x * 3 + 0] = src[x * 4 + 0];
+            capture_row[x * 3 + 1] = src[x * 4 + 1];
+            capture_row[x * 3 + 2] = src[x * 4 + 2];
+        }
+        fwrite(capture_row, 1, row_size, capture_stream);
+    }
+}
+
+static void capture_render_offscreen(void *bitmap, void *previous,
+                                     unsigned width, unsigned height,
+                                     unsigned out_width, unsigned out_height,
+                                     GB_frame_blending_mode_t mode)
+{
+    width = out_width; height = out_height;
+    if (capture_fbo_width != (int) width || capture_fbo_height != (int) height) {
+        if (capture_fbo) glDeleteFramebuffers(1, &capture_fbo);
+        if (capture_texture) glDeleteTextures(1, &capture_texture);
+        glGenTextures(1, &capture_texture);
+        glBindTexture(GL_TEXTURE_2D, capture_texture);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, width, height, 0, GL_RGBA,
+                     GL_UNSIGNED_BYTE, NULL);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        glGenFramebuffers(1, &capture_fbo);
+        glBindFramebuffer(GL_FRAMEBUFFER, capture_fbo);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                               GL_TEXTURE_2D, capture_texture, 0);
+        capture_fbo_width = width;
+        capture_fbo_height = height;
+    }
+    glBindFramebuffer(GL_FRAMEBUFFER, capture_fbo);
+    glViewport(0, 0, width, height);
+    glClearColor(0, 0, 0, 1);
+    glClear(GL_COLOR_BUFFER_BIT);
+    render_bitmap_with_shader(&shader, bitmap, previous,
+                              GB_get_screen_width(&gb), GB_get_screen_height(&gb),
+                              0, 0, width, height, mode);
+    capture_rendered_frame();
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+}
